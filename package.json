{
  "name": "raiz-protocol",
  "version": "1.2.0",
  "private": true,
  "description": "Decentralized RWA Attestation & AI Oracle Infrastructure on Stellar & Soroban for Fair Trade, EUDR Compliance, and Indigenous Agricultural Communities in Oaxaca.",
  "homepage": "https://github.com/Open-Hub-Tec/raiz#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Hub-Tec/raiz.git"
  },
  "author": "TecNM Campus Tlaxiaco & Open Hub Tec",
  "license": "MIT",
  "keywords": [
    "stellar",
    "soroban",
    "rwa",
    "attestations",
    "ai-oracles",
    "eas",
    "eudr-compliance",
    "fair-trade",
    "agriculture",
    "drips-network",
    "public-goods",
    "tecnm",
    "tlaxiaco",
    "oaxaca",
    "fintech"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/qr.test.ts && tsx src/tests/dynamic_process.test.ts && tsx src/tests/complete_system_audit.test.ts && tsx src/tests/hybrid_architecture_and_auth.test.ts && tsx src/tests/ai_oracles_and_protocol.test.ts && tsx src/tests/trustless_work_escrow.test.ts",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
